# User configuration

export BROWSER="yandex-browser-stable"
export EDITOR="nvim"
export FILE="yazi"
export READER="zathura"
export TERMINAL="kitty"

# set PATH so it includes user's private bin if it exists
for dir in "$HOME/bin" "$HOME/.cargo/bin" "$HOME/.local/bin" "$HOME/go/bin" "/usr/local/go/bin"; do
  [ -d "$dir" ] && export PATH="$PATH:$dir"
done

# For Cisco AnyConnect Login to work on NVIDIA
# export WEBKIT_DISABLE_DMABUF_RENDERER=1

alias mvi="mpv --config-dir=$HOME/.config/mvi"
alias curl="curl --proto '=https' --tlsv1.2"
copy2clipboard() {
  if [[ -n $WAYLAND_DISPLAY ]] && command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "${*:-$(< /dev/stdin)}" | wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "${*:-$(< /dev/stdin)}" | xclip -sel clip
  elif command -v xsel >/dev/null 2>&1; then
    printf '%s' "${*:-$(< /dev/stdin)}" | xsel --clipboard --input
  else
    echo "copy2clipboard: no clipboard tool found" >&2
    return 1
  fi
}
